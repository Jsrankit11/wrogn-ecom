# =================================================================
# 🛒 WROGN E-COMMERCE - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and customize values according to your setup
# =================================================================

# -----------------------------------------------------------------
# 1. 🌐 SERVER & APP CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
APP_NAME=Wrogn E-Commerce Store
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# -----------------------------------------------------------------
# 2. 🗄️ DATABASE CONFIGURATION (MongoDB)
# -----------------------------------------------------------------
# For Local MongoDB (Default with in-memory fallback):
MONGODB_URI=mongodb://localhost:27017/wrogn
DB_NAME=wrogn

# For MongoDB Atlas Cloud Database:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wrogn?retryWrites=true&w=majority

# -----------------------------------------------------------------
# 3. 🔐 JWT AUTHENTICATION & SECURITY
# -----------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# -----------------------------------------------------------------
# 4. 👑 DEFAULT ADMIN CREDENTIALS
# -----------------------------------------------------------------
ADMIN_NAME=Wrogn Admin
ADMIN_EMAIL=admin@wrogn.com
ADMIN_PASSWORD=Admin@12345

# -----------------------------------------------------------------
# 5. 💳 PAYMENT GATEWAY CONFIGURATION (Optional)
# -----------------------------------------------------------------
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Stripe (Global)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# -----------------------------------------------------------------
# 6. 📧 EMAIL / SMTP SETTINGS (For Order Confirmation & Password Reset)
# -----------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=noreply@wrogn.com
FROM_NAME=Wrogn Customer Support

# -----------------------------------------------------------------
# 7. ☁️ CLOUD IMAGE STORAGE (Cloudinary / AWS S3)
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------
# 8. 🚀 PRODUCTION & HOSTING
# -----------------------------------------------------------------
# VERCEL=1
