# Wrogn E-Commerce Environment Configuration Template
# Copy this file to .env and customize values as needed

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB URI or MongoDB Atlas Cloud URI (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/wrogn)
MONGODB_URI=mongodb://localhost:27017/wrogn

# JWT Authentication Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
